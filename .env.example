# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tokensense?schema=public"

# Proxy
PORT=8787
PROXY_BASE_URL="http://localhost:8787"

# Provider keys used when the user does not supply their own (dev only)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Encryption key for user API keys at rest (32-byte hex = 64 chars)
API_KEY_ENCRYPTION_SECRET="change-me-to-a-64-char-hex-string-in-production!!!!!!!!"

# Clerk (dashboard auth — Phase 2+)
CLERK_SECRET_KEY=""
CLERK_PUBLISHABLE_KEY=""
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""

# Redis (rate limiting — optional in Phase 1)
REDIS_URL="redis://localhost:6379"

# ClickHouse (analytics — optional; Phase 1 uses Postgres)
CLICKHOUSE_URL=""
CLICKHOUSE_USER=""
CLICKHOUSE_PASSWORD=""
